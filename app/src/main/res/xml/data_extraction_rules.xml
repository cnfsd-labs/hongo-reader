<?xml version="1.0" encoding="utf-8"?>
<!-- Only the reader's choices (shared preferences "settings": accent colour, Anki deck and voice)
     are backed up and moved to a new phone. The database is left out (dictionaries can be
     hundreds of MB and are downloaded again), so the book files, fonts and ttu's copies of the
     books would only be orphans that push the backup past Android's 25 MB limit, where it is
     skipped entirely. "device" preferences (first start done, the Keystore-encrypted Google key,
     AnkiDroid ids) belong to this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
