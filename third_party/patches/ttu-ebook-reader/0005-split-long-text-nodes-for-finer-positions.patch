+/**
+ * Positions (the character count, bookmarks) are worked out per text node, so a paragraph
+ * longer than a page kept the same count page after page. Long text nodes are split, at sentence
+ * ends where possible: the text looks the same, positions get finer.
+ */
+const MAX_TEXT_LENGTH = 120;
+const MIN_PIECE_LENGTH = 20;
+const SENTENCE_END = /[。！？!?…]+[」』）)]*/g;
+
+function splitLongText(node: Text): Node[] {
+  const text = node.data;
+  if (text.length <= MAX_TEXT_LENGTH || !node.parentNode) {
+    return [node];
+  }
+  const cuts: number[] = [];
+  let last = 0;
+  for (const match of text.matchAll(SENTENCE_END)) {
+    const end = (match.index ?? 0) + match[0].length;
+    if (end - last >= MIN_PIECE_LENGTH && text.length - end >= MIN_PIECE_LENGTH) {
+      cuts.push(end);
+      last = end;
+    }
+  }
+  // Text without sentence ends: plain cuts.
+  const pieces: number[] = [];
+  let start = 0;
+  for (const cut of [...cuts, text.length]) {
+    for (let next = start + MAX_TEXT_LENGTH; next < cut; next += MAX_TEXT_LENGTH) {
+      pieces.push(next);
+    }
+    if (cut < text.length) pieces.push(cut);
+    start = cut;
+  }
+  const nodes: Node[] = [node];
+  let current = node;
+  let offset = 0;
+  for (const cut of pieces) {
+    current = current.splitText(cut - offset);
+    offset = cut;
+    nodes.push(current);
+  }
+  return nodes;
+}
